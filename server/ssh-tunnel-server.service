[Unit]
Description=SSH Tunnel Server
Documentation=https://github.com/mafn/SSHTunnel
After=network.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
TimeoutStartSec=0

# Environment file
EnvironmentFile=-/etc/ssh-tunnel/server.env

# Stop the container when stopping the service
ExecStop=/usr/bin/podman stop -t 10 ssh-tunnel-server

# Remove the container when stopping the service
ExecStopPost=/usr/bin/podman rm -f ssh-tunnel-server

# Start the container
ExecStart=/usr/bin/podman run \
  --rm \
  --name ssh-tunnel-server \
  --label io.containers.autoupdate=registry \
  -p 2222:2222 \
  -p 127.0.0.1:8080:8080 \
  -v /etc/ssh-tunnel/keys:/ssh-keys:ro,z \
  --env-file /etc/ssh-tunnel/server.env \
  --security-opt no-new-privileges:true \
  --cap-drop ALL \
  --cap-add SETUID \
  --cap-add SETGID \
  --cap-add CHOWN \
  --cap-add DAC_OVERRIDE \
  --cap-add SYS_CHROOT \
  --tmpfs /tmp:size=100m,noexec,nosuid,nodev \
  ghcr.io/mafn/sshtunnel/server:latest

[Install]
WantedBy=multi-user.target
