[Unit]
Description=SSH Tunnel Server (Quadlet)
Documentation=https://github.com/mafn/SSHTunnel
After=network.target
Wants=network-online.target

[Container]
Image=ghcr.io/mafn/sshtunnel/server:latest
ContainerName=ssh-tunnel-server
AutoUpdate=registry

# Environment file
EnvironmentFile=/etc/ssh-tunnel/server.env

# Ports
PublishPort=${SSH_PORT:-2222}:22
PublishPort=127.0.0.1:${FORWARDED_PORT:-8080}:8080

# Volumes
Volume=/etc/ssh-tunnel/keys:/ssh-keys:ro

# Security
SecurityLabelDisable=false
NoNewPrivileges=true
DropCapability=ALL
AddCapability=SETUID SETGID CHOWN DAC_OVERRIDE

# Tmpfs (sshd needs /var/run writable, so no read-only filesystem)
Tmpfs=/tmp:size=100m,noexec,nosuid,nodev

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target default.target
